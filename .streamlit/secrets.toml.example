# Copy values into Streamlit Community Cloud → App settings → Secrets
# (TOML format). Do not commit real keys.

PRA_LLM_BACKEND = "cerebras"
CEREBRAS_API_KEY = "your-cerebras-api-key"
CEREBRAS_BASE_URL = "https://api.cerebras.ai/v1"
CEREBRAS_MODEL = "gemma-4-31b"
PRA_RETRIEVAL_METHOD = "hybrid"

# --- Optional: Neon (or Supabase) Postgres for Cloud thumbs / conversation_logs ---
# Create a free project at https://console.neon.tech → Connection details.
# Use the pooled host if Neon shows both. SSL is required.
#
# POSTGRES_HOST = "ep-xxxxxxxx.region.aws.neon.tech"
# POSTGRES_PORT = "5432"
# POSTGRES_DB = "neondb"
# POSTGRES_USER = "neondb_owner"
# POSTGRES_PASSWORD = "your-neon-password"
# POSTGRES_SSLMODE = "require"
