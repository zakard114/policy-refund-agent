# Copy values into Streamlit Community Cloud → App settings → Secrets
# (TOML format). Do not commit real keys.

PRA_LLM_BACKEND = "cerebras"
CEREBRAS_API_KEY = "your-cerebras-api-key"
CEREBRAS_BASE_URL = "https://api.cerebras.ai/v1"
CEREBRAS_MODEL = "gemma-4-31b"
PRA_RETRIEVAL_METHOD = "hybrid"

# Optional: remote Postgres for conversation_logs + thumbs feedback.
# Leave unset on Streamlit Cloud if you only need Q&A (logging fails soft).
# POSTGRES_HOST = "..."
# POSTGRES_PORT = "5432"
# POSTGRES_DB = "policy_refund_agent"
# POSTGRES_USER = "pra"
# POSTGRES_PASSWORD = "..."
