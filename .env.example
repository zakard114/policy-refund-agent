# Copy to .env (gitignored). Set at least CEREBRAS_API_KEY before running.
# Streamlit Cloud: use App settings → Secrets (see .streamlit/secrets.toml.example).

# --- App LLM (OpenAI-compatible) ---
# Default: Gemma via Cerebras
PRA_LLM_BACKEND=cerebras
# CEREBRAS_API_KEY=<your-key>
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gemma-4-31b

# Optional search boosts (minsearch)
# PRA_SEARCH_SECTION_BOOST=4.0
# PRA_SEARCH_KEYWORDS_BOOST=2.5
# PRA_SEARCH_TEXT_BOOST=0.8

# Retrieval method: hybrid (RRF, default) | keyword | vector
# PRA_RETRIEVAL_METHOD=hybrid

# --- Postgres + Grafana (docker compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=policy_refund_agent
POSTGRES_USER=pra
POSTGRES_PASSWORD=pra
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3002

# --- Kestra (optional) ---
KESTRA_URL=http://localhost:8085
