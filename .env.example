# Copy to .env (gitignored). Set at least CEREBRAS_API_KEY before running.
# Streamlit Cloud: use App settings → Secrets (see .streamlit/secrets.toml.example).

# --- App LLM (OpenAI-compatible) ---
# Default: Gemma via Cerebras
PRA_LLM_BACKEND=cerebras
# CEREBRAS_API_KEY=<your-key>
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gemma-4-31b

# Optional search boosts (minsearch)
# PRA_SEARCH_SECTION_BOOST=4.0
# PRA_SEARCH_KEYWORDS_BOOST=2.5
# PRA_SEARCH_TEXT_BOOST=0.8

# Retrieval method: hybrid (RRF, default) | keyword | vector
# PRA_RETRIEVAL_METHOD=hybrid

# Product UI whitelist (comma-separated). Default includes current + a few Cerebras ids.
# PRA_ALLOWED_MODELS=gemma-4-31b,llama3.1-8b,qwen-3-32b

# Ops hub gate (Product → Ops 🔒). Local guidance only — never expose Kestra publicly.
# PRA_OPS_PASSWORD=change-me

# --- Postgres + Grafana (docker compose local defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=policy_refund_agent
POSTGRES_USER=pra
POSTGRES_PASSWORD=pra
POSTGRES_SSLMODE=disable
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3002

# Optional: point local Grafana dashboard datasource at Neon (same DB as Cloud app).
# Leave unset to keep Grafana on local pra-postgres :5435.
# PRA_PG_HOST=ep-xxxxxxxx.region.aws.neon.tech:5432
# PRA_PG_USER=neondb_owner
# PRA_PG_PASSWORD=your-neon-password
# PRA_PG_DB=neondb
# PRA_PG_SSLMODE=require

# --- Kestra (optional) ---
KESTRA_URL=http://localhost:8085

# --- Render (official Product + Insights; set in Dashboard, not in git) ---
# See render.yaml and docs/RENDER.md. Same Neon POSTGRES_* / PRA_PG_* as above.
# Streamlit Community Cloud remains secondary (.streamlit/secrets.toml.example).
