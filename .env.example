# Copy to .env (gitignored). Prefer local overrides; shared LLM secrets may also
# be loaded from the workspace shared env file (see app/env_paths.py).

# --- App LLM (OpenAI-compatible) ---
# Default: Gemma via Cerebras
PRA_LLM_BACKEND=cerebras
# Host: keys may come from E:/IT_SPACES/AI/ZoomCamp/LLM/.env (see app/env_paths.py).
# Docker compose streamlit also loads that shared file — or set keys here:
# CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gemma-4-31b

# Optional search boosts (minsearch)
# PRA_SEARCH_SECTION_BOOST=4.0
# PRA_SEARCH_KEYWORDS_BOOST=2.5
# PRA_SEARCH_TEXT_BOOST=0.8

# Retrieval for answer_question: hybrid (RRF, default) | keyword | vector
# PRA_RETRIEVAL_METHOD=hybrid

# --- Postgres + Grafana (docker compose, E: volumes) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=policy_refund_agent
POSTGRES_USER=pra
POSTGRES_PASSWORD=pra
GRAFANA_ADMIN_PASSWORD=admin
# Grafana UI: http://localhost:3002 (port 3000 is often taken by other stacks)
GRAFANA_URL=http://localhost:3002

# --- Kestra (optional) ---
KESTRA_URL=http://localhost:8085
