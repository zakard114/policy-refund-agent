      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pra-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  citation->>'section' AS \"Section\",\n  COUNT(*)::bigint AS \"Count\"\nFROM conversation_logs,\n  LATERAL jsonb_array_elements(COALESCE(used_citations, '[]'::jsonb)) AS citation\nWHERE $__timeFilter(created_at)\n  AND COALESCE(citation->>'section', '') <> ''\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top policy citations",
      "type": "barchart"
